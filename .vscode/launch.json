{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"
            ],
            "outFiles": [
                "${workspaceFolder}/vscode-extension/dist/**/*.js"
            ],
            "preLaunchTask": "npm: watch (vscode-extension)"
        },
        {
            "name": "Extension Tests",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
                "--extensionTestsPath=${workspaceFolder}/vscode-extension/out/test/suite/index"
            ],
            "outFiles": [
                "${workspaceFolder}/vscode-extension/out/test/**/*.js"
            ],
            "preLaunchTask": "npm: watch-tests (vscode-extension)"
        }
    ]
}
