{
    "name": "vscost",
    "displayName": "VSCost",
    "description": "Cost analysis for your AI projects.",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.108.1"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onCommand:vscost.openCostTab",
        "onView:vscost.sidebar"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "vscost",
                    "title": "VSCost",
                    "icon": "assets/vscost-tab-light.svg"
                }
            ]
        },
        "views": {
            "vscost": [
                {
                    "id": "vscost.sidebar",
                    "name": "Cost Overview",
                    "icon": "assets/vscost-tab-light.svg"
                },
                {
                    "id": "vscost.diagnostics",
                    "name": "Diagnostics"
                },
                {
                    "id": "vscost.recommendations",
                    "name": "Quick Picks",
                    "type": "webview"
                }
            ]
        },
        "commands": [
            {
                "command": "vscost.helloWorld",
                "title": "Hello World"
            },
            {
                "command": "vscost.openCostTab",
                "title": "VSCost: Open Cost Tab"
            },
            {
                "command": "vscost.openLocation",
                "title": "VSCost: Open Location"
            },
            {
                "command": "vscost.ignoreThinking",
                "title": "VSCost: Ignore Thinking Warning"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "dependencies": {
        "vscost-parser": "workspace:*"
    },
    "devDependencies": {
        "@types/vscode": "^1.108.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "typescript-eslint": "^8.52.0",
        "eslint": "^9.39.2",
        "esbuild": "^0.27.2",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2"
    }
}
